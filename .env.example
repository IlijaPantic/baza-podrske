# =============================================================================
# Kontrola — environment template
# Kopiraj u `.env` i popuni vrednosti.
# =============================================================================

# --- Aplikacija ---
NODE_ENV=development
PORT=3000

# --- Baza podataka ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# Napomena: host port je 5433 (umesto 5432) iz docker-compose.yml da se ne
# sudara sa postojećim lokalnim Postgres-om koji često sluša na 5432.
DATABASE_URL="postgresql://kontrola:kontrola_dev@localhost:5433/kontrola?schema=public"

# --- Tajni ključevi ---
# Cookie potpis za sesije (HMAC). Minimum 32 karaktera.
# Generiši:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# HMAC ključ za form-token (time-to-fill anti-bot) i 2FA pending-login token.
# Minimum 24 karaktera.
# Generiši:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FORM_TOKEN_SECRET=
