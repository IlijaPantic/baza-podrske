// ============================================================================
//  Kontrola — Prisma schema  (Phase 2 + multi control region)
//
//  Tables:
//    - control_regions    (6 universities; admin scope boundary)
//    - users              (admin users, scoped to one control region)
//    - sessions           (server-side admin sessions)
//    - polling_stations   (seeded from data/ps_regions_1.json, scoped to CR)
//    - registrations      (volunteer registrations, scoped to CR via PS muni)
//    - system_config      (global runtime config: e.g. daily_ip_salt)
//    - audit_log          (append-only security event log)
//
//  Each user belongs to exactly one control region. Admins can only see
//  registrations/polling stations belonging to their control region.
//  There is no super-admin in the UI — global operations go through CLI.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

// ============================================================================
//  ENUMS
// ============================================================================

enum UserRole {
  admin
}

// ============================================================================
//  MODELS
// ============================================================================

/// Control region — admin scope boundary.
/// Static catalog (6 universities) seeded from data/ps_regions_1.json.
/// Each polling station, registration, and user belongs to exactly one CR.
model ControlRegion {
  /// ID matches `ps_regions_1.json` control_regions[].id (1..6).
  id   Int    @id
  name String
  slug String @unique

  /// Per-region survey kill switch. Each control region can independently
  /// open/close its own survey. There is no global toggle in this column —
  /// global ops go through CLI / direct SQL.
  surveyOpen Boolean @default(true) @map("survey_open")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users           User[]
  pollingStations PollingStation[]
  registrations   Registration[]
  auditLogs       AuditLog[]

  @@map("control_regions")
}

/// Admin users. Each user is scoped to exactly one control region.
/// There is no super-admin role; cross-region operations go through CLI.
model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.Citext
  passwordHash     String    @map("password_hash")
  role             UserRole  @default(admin)
  /// Scope boundary — admin can only see data of this control region.
  controlRegionId  Int       @map("control_region_id")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  /// TOTP (2FA) — optional per admin.
  totpSecret    String?   @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz

  controlRegion ControlRegion @relation(fields: [controlRegionId], references: [id], onDelete: Restrict)
  sessions      Session[]

  @@index([controlRegionId])
  @@index([deletedAt])
  @@map("users")
}

/// Admin sessions — server-side, enables immediate revoke and audit.
/// id is 256-bit random base64url (32 bytes entropy).
/// Browser cookie holds only `id`. CSRF token is bound to the session.
model Session {
  id                String    @id // base64url, 43 chars
  userId            String    @map("user_id") @db.Uuid
  csrfToken         String    @map("csrf_token") // base64url, 43 chars
  ipHash            String    @map("ip_hash")
  userAgent         String    @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  /// Slides forward on each request (now + 30 min)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz
  /// Fixed at createdAt + 8h — does not move
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz
  /// Revoke = logout or admin action "sign out all devices"
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// Seed table of polling stations from data/ps_regions_1.json.
/// Filtered to active control regions (e.g. NS=4, KG=2, NIS=3).
/// Each polling station belongs to exactly one control region (via municipality).
model PollingStation {
  id               Int     @id @default(autoincrement())
  /// External polling station ID from `data/ps_regions_1.json` (string).
  /// Unique nationwide across all control regions.
  psId             String? @map("ps_id")
  /// Numeric municipality ID from `data/ps_regions_1.json`.
  /// Used as the primary redirect parameter `?muniid=`.
  /// All polling stations in the same municipality share the same `muniId`.
  muniId           Int?    @map("muni_id")
  /// Control region (university) this polling station belongs to.
  /// Derived from municipality.control_region in source data.
  controlRegionId  Int     @map("control_region_id")
  /// "Бачка Паланка" (Cyrillic, original from source)
  opstinaCir       String  @map("opstina_cir")
  /// "Bačka Palanka" (Latin with diacritics, for display)
  opstinaLat       String  @map("opstina_lat")
  /// "backa-palanka" (URL-friendly, also used in `?opstina=` query
  /// as backward-compat alternative to `?muniid=`)
  opstinaSlug      String  @map("opstina_slug")
  /// Polling station number within the municipality (e.g. "1", "42")
  bmBroj           String  @map("bm_broj")
  /// Institution name in Latin (e.g. 'OŠ "Dositej Obradović"')
  bmNazivLat       String  @map("bm_naziv_lat")
  /// Institution name in Cyrillic (as in the source)
  bmNazivCir       String  @map("bm_naziv_cir")
  /// Raw value from source: '1 - ОШ "ДОСИТЕЈ ОБРАДОВИЋ"'
  bmRaw            String  @map("bm_raw")

  controlRegion ControlRegion  @relation(fields: [controlRegionId], references: [id], onDelete: Restrict)
  registrations Registration[]

  /// psId is unique nationwide (external catalog).
  /// Note: (opstinaSlug, bmBroj) is NOT unique — some municipalities have
  /// duplicate station numbers in the source data (e.g. Vranje).
  @@unique([psId], name: "polling_ps_id_uniq")
  @@index([controlRegionId])
  @@index([opstinaSlug])
  @@index([opstinaSlug, bmBroj])
  @@index([muniId])
  @@map("polling_stations")
}

/// Main table — one registration per volunteer/controller.
model Registration {
  id String @id @default(uuid()) @db.Uuid

  /// Short ID for export (nanoid 8 chars uppercase, e.g. "K2P3X9A8")
  shortId String @unique @map("short_id")

  // -------------- Basic data -----------------------------------------
  firstName String @map("first_name")
  lastName  String @map("last_name")
  /// Optional — not required on the public form
  birthYear Int?   @map("birth_year")

  // -------------- Municipality and polling station ------------------
  /// Display municipality name ("Bačka Palanka") — always present
  opstina          String
  /// Slug for filter ("backa-palanka") — always present
  opstinaSlug      String @map("opstina_slug")
  /// FK to polling_stations — optional (user can skip polling station)
  pollingStationId Int?   @map("polling_station_id")
  /// Control region scope (snapshot). Derived from polling station's
  /// municipality at submit time. Stored even if pollingStationId is null
  /// (resolved from muniId of the chosen opština).
  controlRegionId  Int    @map("control_region_id")

  // -------------- Contact (stored as entered + normalized for uniq) ----
  /// Phone exactly as entered ("065 123 4567")
  phone           String
  /// E.164 normalized ("+381651234567") — for unique constraint
  phoneNormalized String @map("phone_normalized")

  /// Email exactly as entered ("Marko@Gmail.COM")
  email           String
  /// Lowercase for unique constraint
  emailNormalized String @map("email_normalized") @db.Citext

  // -------------- Consent ---------------------------------------------
  consentAt DateTime @map("consent_at") @db.Timestamptz

  // -------------- Registration trace ------------------------------------
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz
  /// sha256(ip + daily_salt) — anonymized IP for rate limiting
  ipHash      String   @map("ip_hash")
  userAgent   String   @map("user_agent")

  // -------------- Phase 2 prep (encryption columns) -----------------
  /// Bytea column that in Phase 2 will hold pgp_sym_encrypt() PII payload.
  /// In Phase 1 it is null. Retrofit migration in Phase 2 will populate and
  /// retire plain columns above.
  piiEnc Bytes? @map("pii_enc")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  pollingStation PollingStation? @relation(fields: [pollingStationId], references: [id], onDelete: Restrict)
  controlRegion  ControlRegion   @relation(fields: [controlRegionId], references: [id], onDelete: Restrict)

  /// Dedupe — never two identical phones/emails
  @@unique([phoneNormalized])
  @@unique([emailNormalized])
  @@index([controlRegionId, submittedAt(sort: Desc)])
  @@index([controlRegionId, opstinaSlug, submittedAt(sort: Desc)])
  @@index([submittedAt(sort: Desc)])
  @@map("registrations")
}

/// Generic key-value config for global runtime parameters.
/// Per-region toggles (like survey_open) live on ControlRegion.
/// Example keys:
///   - "daily_ip_salt" → base64 salt (rotated by cron, global)
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_config")
}

/// Audit log — append-only history of all security-relevant events.
///
/// Events (values of `event` field, kept as string for flexibility):
///   AUTH: LOGIN_OK, LOGIN_FAIL, LOGIN_LOCKED, LOGIN_RATE_LIMITED, LOGOUT,
///         SESSION_EXPIRED, SESSION_REVOKED, CSRF_FAIL
///   ADMIN_USERS: ADMIN_CREATED, ADMIN_PASSWORD_RESET, ADMIN_DEACTIVATED,
///                ADMIN_REACTIVATED, ADMIN_SESSIONS_REVOKED
///   SURVEY: SURVEY_OPENED, SURVEY_CLOSED
///   PUBLIC: SUBMIT_OK, SUBMIT_BOT, SUBMIT_RATE_LIMITED, SUBMIT_VALIDATION,
///           SUBMIT_DUPLICATE
///
/// `metadata` must not contain raw PII (phone, email in plain).
/// Email is logged only as prefix on LOGIN_FAIL (e.g. "ad***@kontrola.org").
model AuditLog {
  id              BigInt   @id @default(autoincrement())
  event           String   @db.VarChar(64)
  /// Who initiated the action. Null for public submit and failed login (unknown user).
  userId          String?  @map("user_id") @db.Uuid
  /// Who the action targets (for admin user management).
  targetUserId    String?  @map("target_user_id") @db.Uuid
  /// Control region the event belongs to. Null for events without a region
  /// context (e.g. unauthenticated failed login attempts).
  controlRegionId Int?     @map("control_region_id")
  /// sha256(ip + daily_salt). Plain IP is never stored.
  ipHash          String   @map("ip_hash")
  userAgent       String   @map("user_agent")
  /// Free-form field — e.g. {"opstinaSlug":"novi-sad","emailMasked":"a***@example.com"}
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  controlRegion ControlRegion? @relation(fields: [controlRegionId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([event, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([controlRegionId, createdAt(sort: Desc)])
  @@map("audit_log")
}
