{
  "name": "kontrola",
  "version": "0.0.1",
  "description": "Web forma za prikupljanje prijava volontera/kontrolora (Vojvodina)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "clean": "node -e \"const fs=require('fs');['dist','tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo'].forEach(p=>{if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true});console.log('removed',p)});\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:extract-bm": "node scripts/extract-bm-vojvodina.js",
    "admin:create": "ts-node --project scripts/tsconfig.json scripts/create-admin.ts"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@nestjs/common": "^11.1.20",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.20",
    "@nestjs/platform-fastify": "^11.1.20",
    "@nestjs/schedule": "^6.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.8.5",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@types/node": "^25.7.0",
    "@types/qrcode": "^1.5.5",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
